{
  "buildCommand": "node scripts/prepare-web.cjs",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/passageiro", "destination": "/passageiro/index.html" },
    { "source": "/motorista", "destination": "/motorista/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sarca.digital" }],
      "destination": "https://sarca.digital/:path*",
      "permanent": true
    }
  ]
}
